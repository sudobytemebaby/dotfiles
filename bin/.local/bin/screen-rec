#!/bin/bash

PID_FILE="/tmp/wf-recorder.pid"
RECORD_DIR="$HOME/Videos/Recordings"
mkdir -p "$RECORD_DIR"

# 1. Если процесс уже идет — убиваем его
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p $PID > /dev/null; then
        kill -INT "$PID"
        rm "$PID_FILE"
        notify-send "Recording" "Stopped and saved"
        exit 0
    fi
    rm "$PID_FILE" # Чистим, если файл остался от упавшего процесса
fi

# 2. Подготовка параметров
FILENAME="$RECORD_DIR/recording_$(date +%Y%m%d_%H%M%S).mp4"
GEOM=""

case "$1" in
    --window)
        # Получаем координаты окна через hyprctl и преобразуем в формат для wf-recorder
        GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        ;;
    --region)
        GEOM=$(slurp)
        [ -z "$GEOM" ] && exit 1
        ;;
esac

# 3. Запуск (добавляем yuv420p для совместимости)
if [ -n "$GEOM" ]; then
    wf-recorder -g "$GEOM" --pixel-format yuv420p -f "$FILENAME" > /dev/null 2>&1 &
else
    wf-recorder --pixel-format yuv420p -f "$FILENAME" > /dev/null 2>&1 &
fi

# Сохраняем PID последнего запущенного процесса
echo $! > "$PID_FILE"
notify-send "Recording" "Started..."
