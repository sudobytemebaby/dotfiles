#!/usr/bin/env bash
set -e

OCR_DIR="$HOME/Pictures/screenshots/ocr"
mkdir -p "$OCR_DIR"

GEOM=$(slurp) || exit 0
[ -z "$GEOM" ] && exit 0

TS=$(date '+%Y%m%d-%H%M%S')
BASE="$OCR_DIR/ocr_$TS"
OUT="$BASE.txt"

if ! grim -g "$GEOM" - | tesseract -l rus+eng --psm 6 - "$BASE" 2>/dev/null; then
    notify-send -a "OCR" "OCR failed" "tesseract returned an error"
    exit 1
fi

if [ ! -s "$OUT" ]; then
    notify-send -a "OCR" "OCR empty" "No text recognized"
    exit 0
fi

wl-copy < "$OUT"

PREVIEW=$(head -c 80 "$OUT" | tr '\n' ' ')
notify-send -a "OCR" "Text recognized" "${PREVIEW}…"

exec footclient --app-id floating_term_l -e nvim "$OUT"
